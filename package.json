{
  "name": "base-milestone-plugins",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "飞书多维表格仪表盘插件:带里程碑的整体进度、下一个里程碑",
  "workspaces": [
    "milestone-overview",
    "dependency-flow",
    "dependency-flow-view/view"
  ],
  "scripts": {
    "dev:overview": "npm run dev -w milestone-overview",
    "build": "npm run build -w milestone-overview && npm run build -w dependency-flow",
    "typecheck": "tsc -p milestone-overview --noEmit && tsc -p dependency-flow --noEmit",
    "test": "node --experimental-strip-types --test shared/test/*.test.ts dependency-flow/test/*.test.ts",
    "dev:flow": "npm run dev -w dependency-flow"
  }
}
